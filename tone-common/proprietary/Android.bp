// LOS22.2: architecture-correct Sony legacy prebuilts
// Keep ARM32 and ARM64 variants in their respective lib directories.

cc_prebuilt_library_shared {
    name: "sony_dora_legacy_display_color",
    stem: "vendor.display.color@1.0",
    compile_multilib: "both",
    check_elf_files: false,
    strip: { none: true },
    product_specific: true,
    target: {
        android_arm: {
            srcs: ["product/lib/vendor.display.color@1.0.so"],
        },
        android_arm64: {
            srcs: ["product/lib64/vendor.display.color@1.0.so"],
        },
    },
}

